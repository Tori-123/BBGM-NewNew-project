# Copy to .env and fill in locally. Do not commit .env.

# Persistence (PRD M8). Run uvicorn from backend/: sqlite:///./scoop.db
DATABASE_URL=sqlite:///./scoop.db

# Cookie session (schema: scoop_session). Local placeholder only; change before sharing the machine.
SESSION_SECRET=dev-only-change-me

# Browser origin for later CORS. No third-party API keys in v1.
FRONTEND_ORIGIN=http://localhost:5173

# Super-admin email (lowercase). That account becomes admin on register or login.
# Leave empty until you name the person. Do not commit a real address.
ADMIN_EMAIL=
